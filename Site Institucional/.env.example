# Copie para .env.dev. O app.js usa esse arquivo no modo desenvolvimento.
# No modo produção, o app.js usa .env.
AMBIENTE_PROCESSO=desenvolvimento
APP_HOST=localhost
APP_PORT=3333

# Imagem publicada no Docker Hub. Usada pelo Docker Compose.
SITE_IMAGE=mickaelarodrigues/meu_site:v4

# Use o mesmo banco MySQL dos scripts Python.
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=db_peakstack
DB_USER=seu_usuario
DB_PASSWORD=sua_senha

# Senha inicial do administrador do MySQL no Docker Compose.
MYSQL_ROOT_PASSWORD=sua_senha_root

# Opcional. Nome de um volume MySQL existente que você queira reutilizar.
# MYSQL_VOLUME_NAME=ubuntu_mysql_data
